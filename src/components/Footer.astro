---
const year = new Date().getFullYear();

// 根据当前路径判断语言，渲染对应的尾页引文
const isZh = Astro.url.pathname.startsWith('/zh');

const quote = isZh
  ? '我曾经想过变成一个堵上眼睛和耳朵，缄口不言的人，我应该这样做吗？'
  : "I thought what I'd do was, I'd pretend I was one of those deaf-mutes, or should I?";
---

<footer class="footer">
  <div class="footer-inner">
    <span>© {year} Yang Ziyue</span>
    <span class="links">
      <a href="mailto:YOUR_EMAIL@example.com">Email</a> ·
      <a href="https://github.com/YOUR_GITHUB_USERNAME" target="_blank" rel="noopener">GitHub</a> ·
      <a href="https://scholar.google.com/citations?user=YOUR_SCHOLAR_ID" target="_blank" rel="noopener">Scholar</a>
    </span>
  </div>

  {/* 尾页小字引文：放在 © 行下方，居中、更小一号 */}
  <p class="footer-quote">{quote}</p>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    margin-top: 3rem;
    padding: 1.25rem 1.25rem;
    color: var(--color-muted);
    font-size: 0.85rem;
  }
  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .links a { color: var(--color-muted); }
  .links a:hover { color: var(--color-accent); }

  .footer-quote {
    max-width: var(--max-width);
    margin: 0.5rem auto 0;
    padding-top: 0.55rem;
    border-top: 1px dashed var(--color-border);
    text-align: center;
    font-size: 0.78rem;
    font-style: italic;
    color: var(--color-muted);
    line-height: 1.7;
    opacity: 0.85;
  }
</style>
