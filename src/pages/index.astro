---
import Base from '../layouts/Base.astro';
import PaperCard from '../components/PaperCard.astro';
import GameCard from '../components/GameCard.astro';
import VolunteerCard from '../components/VolunteerCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

// 收集所有内容，按时间倒序
const papers = (await getCollection('papers'))
  .sort((a, b) => b.data.year - a.data.year || +b.data.date - +a.data.date);

const games = (await getCollection('games'))
  .sort((a, b) => b.data.year - a.data.year || +b.data.date - +a.data.date);

const projects = (await getCollection('projects'))
  .sort((a, b) => +b.data.date - +a.data.date);

const volunteers = (await getCollection('volunteers'))
  .sort((a, b) => +b.data.date - +a.data.date);
---

<Base title="Yang Ziyue">
  {/* ============ 区块 1：个人简介与照片 ============ */}
  <section id="about" class="hero">
    <img src="/images/avatar.png" alt="Yang Ziyue" class="avatar" />
    <h1>Yang Ziyue</h1>
    <p class="subtitle">
      Master Student @ SJTU · AI Agents · Indie Game Developer
    </p>
    <p class="bio">
      I am a master's student in the School of Computer Science at Shanghai Jiao Tong University. I'm studying at <a href="http://speechlab.sjtu.edu.cn/" target="_blank" rel="noopener">X-lance lab</a> under the guidance of <a href="https://coai-sjtu.github.io/" target="_blank" rel="noopener">Professor Chen Lu</a>
    </p>
    <p class="bio">
      Welcome to my personal sites. Here includes <a href="#papers">Research Papers</a>,
      <a href="#games">Games Made</a>, my <a href="#honors">Honors</a>,
      and my <a href="#volunteer">Volunteer Work</a>.
      My research interests lie in scientific research agents and reinforcement learning.
      Additionally, I am an entry-level game developer who has undertaken program and design roles for several independent games.
    </p>

    {/* 个性签名（书法体）—— 直接分区，不加「个人签名：」之类的标签 */}
    <blockquote class="signature">
      the orgiastic future that year by year recedes before us. it eluded us then,<br />
      but that's no matter — tomorrow we will run faster, stretch out arms farther…<br />
      and one fine morning — so we beat on, boats against the current,<br />
      borne back ceaselessly into the past. — <em>The Great Gatsby</em>
    </blockquote>

    <div class="links">
      <a href="mailto:yang-_-ziyue@sjtu.edu.com">✉️ Email</a>
      <a href="https://github.com/Drunk-mooon" target="_blank" rel="noopener">🐙 GitHub</a>
      <a href="https://twitter.com/DrunkMooon_" target="_blank" rel="noopener">🐦 Twitter</a>
    </div>
  </section>

  <hr class="divider" />

  {/* ============ 区块 2：论文 ============ */}
  <section id="papers">
    <h2>📄 Papers</h2>
    <p class="lead">Arrange in descending order of publication year.</p>
    <blockquote class="epigraph">
      I am Amadeus, the Amadeus that dreams.
      <footer>— <cite>Steins;Gate</cite></footer>
    </blockquote>

    {papers.length === 0 ? (
      <p class="empty">还没有论文。在 <code>src/content/papers/</code> 下新建 <code>.md</code> 文件即可添加。</p>
    ) : (
      <ul class="cards">
        {papers.map(p => (
          <PaperCard
            title={p.data.title}
            authors={p.data.authors}
            venue={p.data.venue}
            year={p.data.year}
            pdf={p.data.pdf}
            code={p.data.code}
            project={p.data.project}
            poster={p.data.poster}
            tldr={p.data.tldr}
            abstract={p.data.abstract}
          />
        ))}
      </ul>
    )}
  </section>

  <hr class="divider" />

  {/* ============ 区块 3：游戏 ============ */}
  <section id="games">
    <h2>🎮 Games</h2>
    <p class="lead">Game demos that I have participated in or independently produced.</p>
    <blockquote class="epigraph">
      This is somewhere to be. This is all you have, but it's still something.
      <footer>— <cite>Disco Elysium</cite></footer>
    </blockquote>

    {games.length === 0 ? (
      <p class="empty">还没有游戏。在 <code>src/content/games/</code> 下新建 <code>.md</code> 文件即可添加。</p>
    ) : (
      <ul class="cards">
        {games.map(g => (
          <GameCard
            title={g.data.title}
            cover={g.data.cover}
            platform={g.data.platform}
            year={g.data.year}
            link={g.data.link}
            video={g.data.video}
            description={g.data.description}
            role={g.data.role}
          />
        ))}
      </ul>
    )}
  </section>

  <hr class="divider" />

  {/* ============ 区块 4：个人荣誉（开源项目暂时下线，代码保留见下方注释） ============ */}
  <section id="honors">
    <h2>🏆 Honors</h2>
    <p class="lead">Scholarships and awards I have received.</p>
    <blockquote class="epigraph">
      It's the kind of thing that makes you glad you stopped and smelled the pine trees along the way.
      <footer>— Gabbro, <cite>Outer Wilds</cite></footer>
    </blockquote>

    <ul class="honors">
      <li><span class="honor-year">2026</span><span>Outstanding Graduate of Shanghai Jiao Tong University (Class of 2026)</span></li>
      <li><span class="honor-year">2025</span><span>Tang Zhongying Scholarship</span></li>
      <li><span class="honor-year">2024</span><span>Huawei Scholarship</span></li>
      <li><span class="honor-year">2024</span><span>SJTU Undergraduate Second-Class Excellence Scholarship, AY 2023–2024 (Top 10%)</span></li>
      <li><span class="honor-year">2024</span><span>Honorable Mention, MCM/ICM (Mathematical Contest in Modeling)</span></li>
      <li><span class="honor-year">2023</span><span>First Prize, "Shanshu Cup" Collegiate Mathematical Modeling Elite League</span></li>
    </ul>
  </section>

  {/* ============ 区块 4（备用）：开源项目，暂时下线，恢复时与导航/简介锚点一起换回 ============
  <section id="projects">
    <h2>🛠 Open Source Projects</h2>
    <p class="lead">The open-source projects that I maintain or primarily participate in on GitHub.</p>
    <blockquote class="epigraph">
      The prototype does not exist.
      <footer>— <cite>Ghost in the Shell: Stand Alone Complex</cite></footer>
    </blockquote>

    {projects.length === 0 ? (
      <p class="empty">还没有项目。在 <code>src/content/projects/</code> 下新建 <code>.md</code> 文件即可添加。</p>
    ) : (
      <ul class="cards">
        {projects.map(p => (
          <ProjectCard
            title={p.data.title}
            description={p.data.description}
            github={p.data.github}
            tags={p.data.tags}
            year={p.data.date.getFullYear()}
          />
        ))}
      </ul>
    )}
  </section>
  ============ 区块 4（备用）结束 ============ */}

  <hr class="divider" />

  {/* ============ 区块 5：志愿项目 ============ */}
  <section id="volunteer">
    <h2>🤝 Volunteer Work</h2>
    <p class="lead">Volunteer programs that I have taken part in.</p>
    <blockquote class="epigraph">
      There ain't no shame in looking for a better world.
      <footer>— Arthur Morgan, <cite>Red Dead Redemption 2</cite></footer>
    </blockquote>

    {volunteers.length === 0 ? (
      <p class="empty">还没有志愿项目。在 <code>src/content/volunteers/</code> 下新建 <code>.md</code> 文件即可添加。</p>
    ) : (
      <ul class="cards">
        {volunteers.map(v => (
          <VolunteerCard
            title={v.data.title}
            image={v.data.image}
            time={v.data.time}
            description={v.data.description}
          />
        ))}
      </ul>
    )}
  </section>

  <hr class="divider" />

  {/* ============ 区块 6：爱好（最末，量级最小） ============ */}
  <section id="hobbies" class="hobbies">
    <h2>🌿 Hobbies</h2>
    <p class="hobby-list">
      🎮 PC GAME · 🎸 Guitar · ✨ ACG · 🏀 Basketball &amp; NBA · 📚 Reading
    </p>
  </section>
</Base>